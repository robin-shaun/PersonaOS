# Recommended: a GitHub App installed only on repositories this employee may read.
GITHUB_APP_ID=
# Keep the PEM outside the repository. Do not set this together with the inline key.
GITHUB_APP_PRIVATE_KEY_PATH=
# GITHUB_APP_PRIVATE_KEY=

# Legacy fallback for public repositories or local compatibility.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10

# Defaults to sqlite:///./var/digital_employee.db when omitted.
DIGITAL_EMPLOYEE_DATABASE_URL=
# start.sh runs a conservative Alembic bootstrap and overrides this to false
# for recognized schemas. Keep true only for the pre-persona compatibility path.
# Docker Compose always runs Alembic first and sets this false.
DIGITAL_EMPLOYEE_AUTO_CREATE_SCHEMA=true
# Docker Compose only. Keep this URL-safe unless the database URL is encoded.
POSTGRES_PASSWORD=personaos-local-dev
# rules is the offline default. Set hermes only after configuring the dedicated
# no-tool Hermes API profile described in docs/hermes.md.
DIGITAL_EMPLOYEE_RUNTIME=rules

HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=
HERMES_MODEL=ai-colleague
# Used only by start.sh when it needs to start a local Hermes gateway.
HERMES_PROFILE=ai-colleague
HERMES_REQUEST_TIMEOUT_SECONDS=20
HERMES_POLL_INTERVAL_SECONDS=0.5
HERMES_MAX_CONTEXT_BYTES=1000000

# 18110 is the project default so it does not collide with local services on 8000/18000.
DIGITAL_EMPLOYEE_API_HOST=127.0.0.1
DIGITAL_EMPLOYEE_API_PORT=18110

DIGITAL_EMPLOYEE_QUEUE_MAX_ATTEMPTS=3
DIGITAL_EMPLOYEE_WORKER_POLL_SECONDS=1
DIGITAL_EMPLOYEE_WORKER_LEASE_SECONDS=300
DIGITAL_EMPLOYEE_WORKER_RETRY_DELAY_SECONDS=5
DIGITAL_EMPLOYEE_WORKER_TASK_TIMEOUT_SECONDS=300
DIGITAL_EMPLOYEE_WORKER_CONTROL_POLL_SECONDS=0.25

# Legacy 0.11 owner used only by the explicit migration command. Authenticated
# HTTP requests derive their owner from the server-side session.
PERSONA_LOCAL_OWNER_ID=local-user
# Dedicated HMAC key for CSRF derivation. When omitted, PersonaOS creates
# ./var/persona_auth.key with mode 0600. Do not reuse the Blob key.
PERSONA_AUTH_KEY_PATH=
# Keep false for loopback HTTP. Set true whenever the browser origin uses HTTPS.
PERSONA_COOKIE_SECURE=false
PERSONA_SESSION_IDLE_SECONDS=1800
PERSONA_SESSION_ABSOLUTE_SECONDS=43200
PERSONA_REAUTHENTICATION_SECONDS=300
PERSONA_MAX_SESSIONS_PER_ACCOUNT=5
PERSONA_LOGIN_FAILURE_LIMIT=5
PERSONA_LOGIN_LOCKOUT_SECONDS=60
# Defaults to ./var/persona_blobs. Raw source blobs are AES-256-GCM encrypted.
PERSONA_BLOB_DIR=
# Set exactly one of these. If both are empty, the first upload creates a
# 32-byte key at ./var/persona_blob.key with mode 0600.
PERSONA_BLOB_KEY=
PERSONA_BLOB_KEY_PATH=
PERSONA_MAX_UPLOAD_BYTES=5242880
# JSON export is buffered in memory and rejected above this size.
PERSONA_MAX_EXPORT_BYTES=26214400
# The offline default uses deterministic Unicode feature hashing. Changing the
# dimension creates a new embedding space and requires the reindex task.
PERSONA_EMBEDDING_DIMENSIONS=384
